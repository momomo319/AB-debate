doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    title ABディベート - テーマ一覧
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha256-fx038NkLY4U1TCrBDiu5FWPEa9eiZu01EiLryshJbCo="
      crossorigin="anonymous")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css")
    link(rel="stylesheet" href="/style.css")
  body.container.overflow-scroll
    nav.navbar.fixed-top.bg-primary
      div.container-fluid
        h1.text-light.navbar-brand.mx-auto ABディベート テーマ一覧
          i.bi-book.ms-1 
        div.dropdown
          button.btn.btn-outline-light.dropdown-toggle(type="button" id="menu" data-bs-toggle="dropdown" aria-expanded="false") #{user}
            i.bi-gear-fill.ms-1
          ul.dropdown-menu.dropdown-menu-end(aria-labelledby="menu")
            li
              a.dropdown-item(href="/logout") ログアウト

    .container.py-4.py-md-5 
      .row.justify-content-center 
        .col-lg-9.col-xl-8
          .card.shadow-sm.boarder-0.mb-5 
            .card-body.p-4.p-md-5 
              h2.h4.card-title.mb-4 新しい討論テーマを作成
              form(method="post" action="/topics")
                .mb-4
                  label.form-label.fw-semibold(for="title") テーマ:
                  input#title.form-control.form-control-lg(type="text" name="title" required placeholder= "例: 朝型 vs 夜型")
                .row.g-4.mb-4 
                  .col-md-6 
                    label.form-label.fw-semibold(for="optionA") 選択肢A: 
                    input#optionA(type="text" name="optionA" required placeholder= "例: 朝型")
                  .col-md-6
                    label.form-label.fw-semibold(for="optionB") 選択肢B: 
                    input#optionB(type="text" name="optionB" required placeholder= "例: 夜型")
                .d-flex.justify-content-end.pt-2
                  button.btn.btn-primary.px-4(type="submit") テーマを作成

          h2.h4.mb-3 討論テーマ一覧
          if topics.length === 0
            .card.shadow-sm.boarder-0
              .card-body.p-4.text-center.text-muted
                | まだテーマはありません。
          else 
            .d-flex.flex-column.gap-3
              each topic in topics
                .card.shadow-sm.boarder-0
                  .card-body.p-4
                    .d-flex.justify-content-between.align-items-start.flex-wrap.gap-3
                      div 
                        h3.h5.card-title.mb-2.text-break 
                          a.text-decoration-none(href=`/topics/${topic.id}`) #{topic.title} 
                        .d-flex.flex-wrap.align-items-center.gap-2.mb-2
                          span.badge.text-bg-primary A: #{topic.optionA}
                          span.badge.text-bg-danger B: #{topic.optionB}
                        p.text-muted.small.mb-0 
                          | 投稿数: #{topic._count.posts}件 / 投票数: #{topic._count.votes}票
                      .d-flex.align-items-center.gap-2
                        a.btn.btn-outline-primary.btn-sm(href=`/topics/${topic.id}`)
                          i.bi-chat-dots.me-1
                          | 参加する
                        if user === 'admin'
                          form.m-0(method="post" action="/topics/delete", onsubmit="return confirm('このテーマと関連する投稿・投票をすべて削除しますか？');")
                            input(type="hidden" name="id" value=topic.id)
                            button.btn.btn-outline-danger.btn-sm(type="submit")
                                i.bi-trash

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
      integrity="sha256-qlPVgvl+tZTCpcxYJFdHB/m6mDe84wRr+l81VoYPTgQ="
      crossorigin="anonymous")